    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug ex1 IK loop",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/hw2_robot_control_mdps/scripts/debug_ex1_ik.py",
            "python": "${workspaceFolder}/mujoco/bin/python",
            "cwd": "${workspaceFolder}/hw2_robot_control_mdps",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Debug ex2 quintic spline",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/hw2_robot_control_mdps/scripts/quintic_splines.py",
            "python": "${workspaceFolder}/mujoco/bin/python",
            "cwd": "${workspaceFolder}/hw2_robot_control_mdps",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Debug ex2 PID",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/hw2_robot_control_mdps/scripts/debug_ex2_pid.py",
            "python": "${workspaceFolder}/mujoco/bin/python",
            "cwd": "${workspaceFolder}/hw2_robot_control_mdps",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Debug ex3",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/hw2_robot_control_mdps/scripts/debug_ex3.py",
            "python": "${workspaceFolder}/mujoco/bin/python",
            "cwd": "${workspaceFolder}/hw2_robot_control_mdps",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Debug hw3 train step",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/hw3_imitation_learning/scripts/debug_train_step.py",
            "python": "${workspaceFolder}/hw3_imitation_learning/.venv/bin/python",
            "cwd": "${workspaceFolder}/hw3_imitation_learning",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Debug hw3 train.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/hw3_imitation_learning/scripts/train.py",
            "python": "${workspaceFolder}/hw3_imitation_learning/.venv/bin/python",
            "cwd": "${workspaceFolder}/hw3_imitation_learning",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": [
                "--zarr",
                "datasets/processed/single_cube/processed_ee_xyz.zarr",
                "--policy",
                "obstacle",
                "--state-keys",
                "state_ee_xyz",
                "state_gripper",
                "state_cube",
                "state_obstacle",
                "--action-keys",
                "action_ee_xyz",
                "action_gripper",
                "--chunk-size","16"
            ]
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "python": "${workspaceFolder}/mujoco/bin/python",
            "console": "integratedTerminal"
        }
    ]
}